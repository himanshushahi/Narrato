{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:remotion": "npx remotion bundle src/components/video/root.ts --out-dir dist-remotion",
    "build:render": "npx esbuild src/render.mjs --bundle --platform=node --target=node20 --format=esm --outfile=dist-render/render.mjs --external:fs --external:path --external:http --external:os --external:url --external:child_process --external:stream --external:events --external:buffer --external:util --external:crypto --external:net --external:tls --external:zlib --packages=external",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@remotion/player": "^4.0.190",
    "@tailwindcss/vite": "^4.3.0",
    "@types/d3-geo": "^3.1.0",
    "@types/d3-shape": "^3.1.8",
    "@types/topojson-client": "^3.1.5",
    "d3-geo": "^3.1.1",
    "d3-shape": "^3.2.0",
    "framer-motion": "^12.39.0",
    "highlight.js": "^11.11.1",
    "js-beautify": "^1.15.4",
    "lucide-react": "^1.24.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-icons": "^5.6.0",
    "react-router-dom": "^7.15.1",
    "react-simple-code-editor": "^0.14.1",
    "remotion": "^4.0.190",
    "topojson-client": "^3.1.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@remotion/cli": "^4.0.469",
    "@remotion/renderer": "^4.0.469",
    "@types/js-beautify": "^1.14.3",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.12"
  }
}
