{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:remotion": "npx remotion bundle src/components/video/root.ts --out-dir dist-remotion",
    "build:render": "npx esbuild src/render.mjs --bundle --platform=node --target=node20 --format=esm --outfile=dist-render/render.mjs --external:fs --external:path --external:http --external:os --external:url --external:child_process --external:stream --external:events --external:buffer --external:util --external:crypto --external:net --external:tls --external:zlib --packages=external",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@remotion/lottie": "^4.0.469",
    "@remotion/media-utils": "^4.0.469",
    "@remotion/motion-blur": "^4.0.469",
    "@remotion/noise": "^4.0.469",
    "@remotion/paths": "^4.0.469",
    "@remotion/player": "4.0.469",
    "@remotion/shapes": "^4.0.469",
    "@remotion/transitions": "^4.0.469",
    "@tailwindcss/vite": "4.3.0",
    "@types/d3-geo": "3.1.0",
    "@types/topojson-client": "3.1.5",
    "d3-geo": "3.1.1",
    "framer-motion": "12.39.0",
    "highlight.js": "11.11.1",
    "lottie-web": "^5.13.0",
    "lucide-react": "1.24.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-icons": "5.6.0",
    "react-router-dom": "7.15.1",
    "react-simple-code-editor": "0.14.1",
    "remotion": "4.0.469",
    "topojson-client": "3.1.0",
    "use-sync-external-store": "^1.6.0",
    "zustand": "5.0.13"
  },
  "devDependencies": {
    "@babel/parser": "^8.0.4",
    "@remotion/cli": "4.0.469",
    "@remotion/renderer": "4.0.469",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "4.3.4",
    "esbuild": "0.25.0",
    "eslint": "9.21.0",
    "tailwindcss": "4.0.6",
    "typescript": "5.7.3",
    "vite": "6.1.1"
  }
}
